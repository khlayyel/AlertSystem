@model AlertSystem.Entities.Entities.Alerte
@{
    ViewData["Title"] = "Créer une alerte";
    var isAdmin = User.IsInRole("Admin");
}
<div class="container py-3">
  <h3>Créer une alerte</h3>
  <form asp-action="Create" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="mb-3">
      <label class="form-label">Titre</label>
      <input asp-for="TitreAlerte" class="form-control" />
      <span asp-validation-for="TitreAlerte" class="text-danger small"></span>
    </div>
    <div class="mb-3">
      <label class="form-label">Message</label>
      <textarea asp-for="DescriptionAlerte" class="form-control" rows="4"></textarea>
      <span asp-validation-for="DescriptionAlerte" class="text-danger small"></span>
    </div>
    <div class="row g-3">
      <div class="col-sm-4">
        <label class="form-label">Type</label>
        <select asp-for="AlertTypeId" class="form-select">
          <option value="1">Information (acquittement non nécessaire)</option>
          <option value="2">Obligatoire (acquittement nécessaire)</option>
        </select>
        <span asp-validation-for="AlertTypeId" class="text-danger small"></span>
      </div>
    </div>
    <div class="mt-3 d-flex gap-2">
      <button class="btn btn-primary" type="submit">Enregistrer</button>
      <a class="btn btn-secondary" asp-action="Index">Annuler</a>
    </div>
  </form>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}


