@model AlertSystem.Entities.Entities.Alerte
@{
    ViewData["Title"] = "Détails de l'alerte";
}
<div class="container py-3">
  <h3>@Model.TitreAlerte</h3>
  <dl class="row mt-3">
    <dt class="col-12 col-md-3">Type</dt><dd class="col-12 col-md-9">@Model.AlertType</dd>
    <dt class="col-12 col-md-3">Message</dt><dd class="col-12 col-md-9">@Model.DescriptionAlerte</dd>
    <dt class="col-12 col-md-3">Créée le</dt><dd class="col-12 col-md-9">@Model.DateCreationAlerte.AddHours(1).ToString("yyyy-MM-dd HH:mm")</dd>
  </dl>
  <div class="mt-3 d-flex gap-2">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.AlertRecordId">Modifier</a>
    <a class="btn btn-secondary" asp-action="Index">Retour</a>
  </div>
  
</div>


