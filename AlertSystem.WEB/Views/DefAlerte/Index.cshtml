@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Alertes Définies";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="bi bi-bell me-2 text-primary"></i>Alertes Définies
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Créer une nouvelle alerte définie
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type Alerte</th>
                    <th>Application</th>
                    <th>Destinataires</th>
                    <th>URL</th>
                    <th>Actif</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var defAlerte = item.DefAlerte as AlertSystem.Entities.Entities.DefAlerte;
                    var emails = item.DestinatairesEmails as string;
                    <tr>
                        <td>@defAlerte.DefAlerteId</td>
                        <td>@(defAlerte.TypeAlerte?.Description ?? "N/A")</td>
                        <td>@(defAlerte.TypeAlerte?.App?.Description ?? "N/A")</td>
                        <td>@emails</td>
                        <td><a href="@defAlerte.URL" target="_blank">@defAlerte.URL</a></td>
                        <td>
                            @if (defAlerte.IsActive)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@defAlerte.DefAlerteId" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <a asp-action="Delete" asp-route-id="@defAlerte.DefAlerteId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Supprimer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

