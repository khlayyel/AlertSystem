@model AlertSystem.Entities.Entities.DefAlerte
@{
    ViewData["Title"] = "Modifier une alerte définie";
    var utilisateurs = ViewBag.Utilisateurs as IEnumerable<dynamic>;
    var selectedIds = ViewBag.SelectedDestinataires as List<int> ?? new List<int>();
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="bi bi-pencil me-2 text-primary"></i>Modifier une alerte définie
    </h1>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DefAlerteId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="DefTypeAlerte" class="form-label">Type d'Alerte</label>
                <select asp-for="DefTypeAlerte" class="form-select" asp-items="ViewBag.TypeAlertes">
                    <option value="">-- Sélectionner un type d'alerte --</option>
                </select>
                <span asp-validation-for="DefTypeAlerte" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Destinataires</label>
                <select name="selectedDestinataires" multiple class="form-select" size="8">
                    @foreach (var user in utilisateurs ?? Enumerable.Empty<dynamic>())
                    {
                        var isSelected = selectedIds.Contains((int)user.UtilisateurId);
                        <option value="@user.UtilisateurId" selected="@isSelected">@user.Username (@user.Email)</option>
                    }
                </select>
                <div class="form-text">Maintenez Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs destinataires.</div>
            </div>
            
            <div class="mb-3">
                <label asp-for="URL" class="form-label">URL</label>
                <input asp-for="URL" class="form-control" placeholder="http://localhost:5050/api/v1/stock-alerts" />
                <span asp-validation-for="URL" class="text-danger"></span>
                <div class="form-text">URL de l'endpoint API qui retourne les données JSON (ex: stock_alerts).</div>
            </div>
            
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch"
                           onchange="this.nextElementSibling.querySelector('.state').textContent = this.checked ? 'ON' : 'OFF'; this.nextElementSibling.querySelector('.state').className = this.checked ? 'state badge bg-success' : 'state badge bg-danger';" />
                    <label asp-for="IsActive" class="form-check-label">
                        Activation <span class="state badge @(Model?.IsActive == true ? "bg-success" : "bg-danger")">@(Model?.IsActive == true ? "ON" : "OFF")</span>
                    </label>
                </div>
            </div>
            
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Enregistrer
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i>Annuler
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
