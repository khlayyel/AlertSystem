@model AlertSystem.WEB.Models.ConfirmResultViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Erreur de confirmation";
    var message = Model?.Message ?? "Une erreur est survenue lors de la confirmation.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle" style="width: 80px; height: 80px;">
                            <i class="fas fa-exclamation-triangle text-danger" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>

                    <h2 class="card-title text-danger mb-3">❌ @ViewData["Title"]</h2>
                    <p class="text-muted mb-4">@message</p>

                    <div class="alert alert-danger border-0 bg-light">
                        <h5 class="alert-heading mb-3">
                            <i class="fas fa-times-circle text-danger me-2"></i>
                            @ViewData["Title"]
                        </h5>
                        <p class="mb-0">@message</p>
                    </div>

                    <div class="alert alert-warning border-0">
                        <h6 class="alert-heading">
                            <i class="fas fa-lightbulb text-warning me-2"></i>
                            Causes possibles :
                        </h6>
                        <ul class="list-unstyled mb-0 text-start">
                            <li><i class="fas fa-arrow-right text-warning me-2"></i>Le lien de confirmation a expiré</li>
                            <li><i class="fas fa-arrow-right text-warning me-2"></i>Le lien a déjà été utilisé</li>
                            <li><i class="fas fa-arrow-right text-warning me-2"></i>L'alerte n'existe plus dans le système</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                        <a href="/" class="btn btn-primary btn-lg px-4">
                            <i class="fas fa-home me-2"></i>
                            Retour à l'accueil
                        </a>
                        <a href="/Dashboard" class="btn btn-outline-primary btn-lg px-4">
                            <i class="fas fa-tachometer-alt me-2"></i>
                            Tableau de bord
                        </a>
                    </div>

                    <div class="mt-4">
                        <small class="text-muted">
                            <i class="fas fa-question-circle me-1"></i>
                            Si le problème persiste, contactez l'administrateur
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
    }

    .alert {
        border-radius: 10px;
    }

    .btn {
        border-radius: 8px;
        font-weight: 500;
    }

    .btn-lg {
        padding: 12px 24px;
    }
</style>
