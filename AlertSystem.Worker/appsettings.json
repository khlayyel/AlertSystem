{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AlerteDB;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5185"
  },
  "Polling": {
    "Alerts": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "Endpoint": "http://localhost:5002/api/v1/stock-alerts"
    }
  },
  "Polling:ApiKey": "",
  "AlertTemplates": {
    "Stock": {
      "EPUISE": { "Title": "STOCK ALERT!", "Description": "L'article {nomProduit} est épuisé." },
      "MAX": { "Title": "STOCK ALERT!", "Description": "L'article {nomProduit} a atteint son stock maximum." },
      "Default": { "Title": "STOCK ALERT!", "Description": "{nomProduit}" }
    },
    "Default": {
      "Default": { "Title": "Alerte", "Description": "{nomProduit}" }
    }
  }
}

