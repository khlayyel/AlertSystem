{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WatcherIntervals": {
    "RESASeconds": 60,
    "TPVSeconds": 120,
    "GRHSeconds": 300,
    "BNQSeconds": 300,
    "TRESSeconds": 600
  },
  "WatcherThresholds": {
    "RESA": { "HoursBeforeCheckin": 3 },
    "TPV": { "MinutesAgedTicket": 45 },
    "GRH": { "ContractEndDays": 30 }
  },
  "WatcherCapabilities": {
    "RESA": [ "RESA_MANAGE" ],
    "TPV": [ "TPV_MONITOR" ],
    "COMPTA": [ "AR_OVERDUE" ],
    "GRH": [ "HR_ABS_APPROVE", "HR_CONTRACTS" ],
    "BNQ": [ "BNQ_EVENT" ],
    "TRES": [ "TREASURY_ALERT" ]
  }
}
