{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WatcherIntervals": {
    "RESASeconds": 20,
    "TPVSeconds": 30,
    "GRHSeconds": 60,
    "BNQSeconds": 60,
    "TRESSeconds": 120
  },
  "WatcherThresholds": {
    "RESA": { "HoursBeforeCheckin": 3 },
    "TPV": { "MinutesAgedTicket": 30 },
    "GRH": { "ContractEndDays": 30 }
  },
  "WatcherCapabilities": {
    "RESA": [ "RESA_MANAGE" ],
    "TPV": [ "TPV_MONITOR" ],
    "COMPTA": [ "AR_OVERDUE" ],
    "GRH": [ "HR_ABS_APPROVE", "HR_CONTRACTS" ],
    "BNQ": [ "BNQ_EVENT" ],
    "TRES": [ "TREASURY_ALERT" ]
  }
}
